# Neon Serverless PostgreSQL 연결 문자열
# Neon 콘솔(https://console.neon.tech)에서 발급받은 Pooled/Direct Connection String을 입력하세요.
DATABASE_URL="postgresql://USER:PASSWORD@ep-your-project.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# (선택) 무료 Gemini API 키 — 미설정 시 내장 템플릿 스트리밍 모드로 자동 동작
GEMINI_API_KEY=""

# (선택) 공공데이터포털(data.go.kr) 인증키 — 미설정 시 광주 북구 로컬 스냅샷 Fallback 자동 전환
PUBLIC_DATA_API_KEY=""
